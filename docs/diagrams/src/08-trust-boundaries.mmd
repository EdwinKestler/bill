flowchart LR
    classDef trusted fill:#dcfce7,stroke:#16803a,color:#12351f,stroke-width:2px
    classDef device fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:2px
    classDef external fill:#f1f5f9,stroke:#64748b,color:#1e293b,stroke-width:2px
    classDef warning fill:#fff7ed,stroke:#ea580c,color:#431407,stroke-width:2px
    classDef denied fill:#fee2e2,stroke:#dc2626,color:#450a0a,stroke-width:2px

    human["Human exact confirmation"]:::trusted

    subgraph custodyA["Dock A custody"]
        walletA["Wallet A mnemonic datadir and lock"]:::trusted
    end

    subgraph vaultBoundary["Trusted note-vault custody"]
        noteN["Disposable note wallet N keys"]:::warning
        journal["Plan claim hash and recovery journal"]:::trusted
        noteN --> journal
    end

    subgraph physical["Extractable physical bearer boundary"]
        billA["ESP32 Bill A | opaque capability"]:::device
        billB["ESP32 Bill B | opaque capability"]:::device
        copyRisk["Copied capsule | first redemption wins"]:::warning
        billA <-.->|"unauthenticated proximity BLE"| billB
        copyRisk -.-> billA
        copyRisk -.-> billB
    end

    subgraph custodyB["Dock B custody"]
        walletB["Wallet B mnemonic datadir and lock"]:::trusted
        verifier["Exact txid assignment and balance verifier"]:::trusted
        walletB --> verifier
    end

    chain["Mutinynet indexer and Bitcoin network"]:::external
    wifiDenied["No dock-to-dock network payload transport"]:::denied
    secretDenied["No mnemonic claim secret or capsule in public logs"]:::denied

    human -->|"fresh one-use plan approval"| walletA
    human -->|"fresh one-use redemption approval"| journal
    walletA -->|"RGB funding"| chain
    noteN -->|"RGB redemption"| chain
    walletB -->|"refresh validation"| chain
    journal -->|"canonical capsule"| billA
    billB -->|"exact extracted capsule"| walletB
    walletA -.-> wifiDenied
    noteN -.-> secretDenied
