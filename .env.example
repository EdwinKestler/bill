# Mutinynet only. Never put a mainnet seed in this file or in agent configs.

# Which physical bill this dock drives: A (loaded / printer) or B (empty / receive)
BILL_ROLE=A

# BLE adapter on Linux, if more than one exists (empty = default)
BLE_ADAPTER=

# Advertised name the dock scans for. Must match firmware BLE_DEVICE_NAME.
BLE_DEVICE_NAME=RgbBill

# Optional migration fallback. The web dock can scan, verify, and register one
# physical bill from the browser; that role-scoped registration takes priority.
# Example for the current prototype: 30:AE:A4:07:2D:2E
BLE_DEVICE_ADDRESS=
# Optional registration path. Empty defaults to .dock-registration-a.json or
# .dock-registration-b.json according to BILL_ROLE. These files are ignored.
BLE_REGISTRATION_FILE=
BLE_TIMEOUT_SECONDS=8

# rgb-lib data directories. One mnemonic, one directory, one live process per bill.
RGB_DATA_DIR_A=./wallet-data/bill-a
RGB_DATA_DIR_B=./wallet-data/bill-b

# Each dock process reads credentials for its active BILL_ROLE only. Store the
# mnemonic in a chmod 600 file under the ignored secrets/ directory; never put
# mnemonic words in this env file.
RGB_MASTER_FINGERPRINT_A=
RGB_MNEMONIC_FILE_A=./secrets/bill-a.mnemonic
RGB_MASTER_FINGERPRINT_B=
RGB_MNEMONIC_FILE_B=./secrets/bill-b.mnemonic

# Mutinynet custom-signet indexer. The adapter rejects other hosts/networks.
ELECTRUM_URL=https://mutinynet.com/api

# Consignment path: empty transport endpoints. BLE is the only payload hop.
RGB_OOB_CONSIGNMENT=1
# Bootstrap/faucet exception only. The Bill A -> Bill B tap transfer never uses it.
RGB_BOOTSTRAP_PROXY=rpcs://proxy.kaleidoswap.com/json-rpc
RGB_OOB_INBOX_A=./.rgb-oob/bill-a
RGB_OOB_INBOX_B=./.rgb-oob/bill-b
RGB_MIN_CONFIRMATIONS=1
RGB_FEE_RATE=2
RGB_WITNESS_AMOUNT_SAT=1000
# Must not exceed the accepted ESP32 SPIFFS/BLE staging limit (640 KiB).
RGB_MAX_CONSIGNMENT_BYTES=655360
# Exact live RGB asset selected for the web dock. Amounts are converted from
# cents to integer base units using this precision.
RGB_ASSET_ID=
RGB_ASSET_PRECISION=6

# Web dock (python -m web.server)
DOCK_HTTP_HOST=127.0.0.1
DOCK_HTTP_PORT=8788

# QVAC on this dock. cacheDirectory must be an absolute path. Leave empty
# and install_qvac.sh / scripts/qvac_smoke.py use <this folder>/.qvac.
# Example: QVAC_CACHE_DIR=/media/kestl/andor/github/rgbhackathon/ideas/bill/.qvac
QVAC_CACHE_DIR=

# Optional: point at a local @qvac/sdk tree (vendor/tetherto/qvac/packages/sdk).
# Fat wheel needs neither this nor Node.
QVAC_SDK_DIR=

# Optional: thin-wheel worker home. Unused when the bundled linux-x64 wheel is installed.
# QVAC_WORKER_HOME=

# Catalog constant for the dock instruct model (phase 3: small Qwen3 0.6B Q4).
QVAC_MODEL=QWEN3_600M_INST_Q4
